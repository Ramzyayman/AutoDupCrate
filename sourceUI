local mutationESPEnabled = false


local cooldown = {}



--------------------------------------------------------
-- AUTO PICKUP
--------------------------------------------------------

local function triggerPrompt(prompt)

	if cooldown[prompt] then
		return
	end


	cooldown[prompt] = true


	prompt:InputHoldBegin()

	task.wait(0.15)

	prompt:InputHoldEnd()


	task.delay(1,function()

		cooldown[prompt] = nil

	end)

end



local function AutoPickup()

	while autoPickupEnabled do


		for _,obj in ipairs(cratesFolder:GetDescendants()) do


			if obj:IsA("ProximityPrompt")
			and obj.ActionText == "Pickup" then


				triggerPrompt(obj)


			end


		end


		task.wait(0.1)

	end

end



--------------------------------------------------------
-- ANTI IDLE
--------------------------------------------------------

local function EnableAntiIdle()


	if antiIdleInitialized then
		return
	end


	antiIdleInitialized = true



	if getconnections then


		for _,connection in pairs(getconnections(LocalPlayer.Idled)) do


			if connection.Disable then

				connection:Disable()


			elseif connection.Disconnect then

				connection:Disconnect()

			end


		end



	else


		LocalPlayer.Idled:Connect(function()


			if antiIdleEnabled then


				VirtualUser:CaptureController()

				VirtualUser:ClickButton2(
					Vector2.new()
				)


			end


		end)


	end


end
--------------------------------------------------------
-- MUTATION ESP
--------------------------------------------------------

local mutationESP = {}


--------------------------------------------------------
-- FIND ALL MUTATIONS
--------------------------------------------------------

local function getMutations(crate)

	local mutations = {}

	for _,child in ipairs(crate:GetDescendants()) do


		-- Mutations are Parts
		if child:IsA("Part") then


			-- Ignore normal crate parts
			if not child.Name:find("Crates_Cube")
			and not child.Name:find("Mesh")
			and child.Name ~= "ProximityPromptPart" then


				table.insert(
					mutations,
					child.Name
				)


			end


		end


	end


	return mutations

end



--------------------------------------------------------
-- FORMAT MUTATION TEXT
--------------------------------------------------------

local function formatMutations(mutations)


	local text = ""

	local perLine = 5


	for i,name in ipairs(mutations) do


		if (i - 1) % perLine == 0 then

			text = text .. "\n[ "

		end



		text = text .. name



		if i % perLine == 0 then

			text = text .. " ]"


		elseif i < #mutations then

			text = text .. ", "


		else

			text = text .. " ]"


		end


	end


	return text

end



--------------------------------------------------------
-- CREATE ESP
--------------------------------------------------------

local function createMutationESP(crate)


	if mutationESP[crate] then
		return
	end



	local mutations = getMutations(crate)



	if #mutations == 0 then
		return
	end



	local part = crate:FindFirstChildWhichIsA(
		"BasePart",
		true
	)



	if not part then
		return
	end




	local lines = math.ceil(
		#mutations / 5
	)



	local gui = Instance.new("BillboardGui")

	gui.Name = "MutationESP"

	gui.Adornee = part

	gui.AlwaysOnTop = true

	gui.Size = UDim2.new(
		0,
		350,
		0,
		50 + (lines * 25)
	)

	gui.StudsOffset = Vector3.new(
		0,
		4,
		0
	)

	gui.Parent = part




	local label = Instance.new("TextLabel")

	label.Size = UDim2.new(
		1,
		0,
		1,
		0
	)


	label.BackgroundTransparency = 1


	label.TextColor3 = Color3.new(
		1,
		1,
		1
	)


	label.TextStrokeTransparency = 0


	label.Font = Enum.Font.GothamBold


	label.TextSize = 14


	label.TextWrapped = true


	label.Text =
		"[ "..crate.Name.." Crate ]" ..
		formatMutations(mutations)



	label.Parent = gui



	mutationESP[crate] = gui


	print(
		"Mutation ESP:",
		crate.Name,
		table.concat(mutations,", ")
	)

end



--------------------------------------------------------
-- REMOVE ESP
--------------------------------------------------------

local function clearMutationESP()


	for crate,gui in pairs(mutationESP) do


		if gui then

			gui:Destroy()

		end


		mutationESP[crate] = nil


	end


end



--------------------------------------------------------
-- ESP LOOP
--------------------------------------------------------

local function MutationLoop()


	while mutationESPEnabled do


		for _,obj in ipairs(plot.Machines:GetDescendants()) do


			if obj:IsA("Model")
			and obj.Parent
			and obj.Parent.Name == "CratesFolder" then


				createMutationESP(obj)


			end


		end


		task.wait(1)


	end



	clearMutationESP()

end



