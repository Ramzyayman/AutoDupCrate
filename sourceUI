--// Dragging

local dragging = false
local dragStart
local startPos

frame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = frame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart

		frame.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

--------------------------------------------------------

local plot = workspace.Plots:WaitForChild(LocalPlayer.Name .. " Plot")
local duplicator = plot.Machines:WaitForChild("Duplicator")
local cratesFolder = duplicator:WaitForChild("CratesFolder")

local running = false
local cooldown = {}

local function triggerPrompt(prompt)

	if cooldown[prompt] then
		return
	end

	cooldown[prompt] = true

	prompt:InputHoldBegin()
	task.wait(0.15)
	prompt:InputHoldEnd()

	task.delay(1,function()
		cooldown[prompt] = nil
	end)

end

local function AutoPickup()

	while running do

		for _,obj in ipairs(cratesFolder:GetDescendants()) do

			if obj:IsA("ProximityPrompt")
			and obj.ActionText == "Pickup" then

				triggerPrompt(obj)

			end

		end

		task.wait(0.1)

	end

end

toggle.MouseButton1Click:Connect(function()

	running = not running

	if running then

		toggle.Text = "Auto Pickup : ON"
		toggle.BackgroundColor3 = Color3.fromRGB(50,170,50)

		task.spawn(AutoPickup)

	else

		toggle.Text = "Auto Pickup : OFF"
		toggle.BackgroundColor3 = Color3.fromRGB(170,50,50)

	end

end)
