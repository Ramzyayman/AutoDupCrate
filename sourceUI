-- Variables
--------------------------------------------------------

local plot = workspace.Plots:WaitForChild(LocalPlayer.Name .. " Plot")
local duplicator = plot.Machines:WaitForChild("Duplicator")
local cratesFolder = duplicator:WaitForChild("CratesFolder")

local autoPickupEnabled = false
local antiIdleEnabled = false
local antiIdleInitialized = false

local cooldown = {}

--------------------------------------------------------
-- Auto Pickup
--------------------------------------------------------

local function triggerPrompt(prompt)

	if cooldown[prompt] then
		return
	end

	cooldown[prompt] = true

	prompt:InputHoldBegin()
	task.wait(0.15)
	prompt:InputHoldEnd()

	task.delay(1,function()
		cooldown[prompt] = nil
	end)

end

local function AutoPickup()

	while autoPickupEnabled do

		for _,obj in ipairs(cratesFolder:GetDescendants()) do

			if obj:IsA("ProximityPrompt")
				and obj.ActionText == "Pickup" then

				triggerPrompt(obj)

			end

		end

		task.wait(0.1)

	end

end

--------------------------------------------------------
-- Anti Idle
--------------------------------------------------------

local function EnableAntiIdle()

	if antiIdleInitialized then
		return
	end

	antiIdleInitialized = true

	if getconnections then

		for _,connection in pairs(getconnections(LocalPlayer.Idled)) do

			if connection.Disable then
				connection:Disable()

			elseif connection.Disconnect then
				connection:Disconnect()

			end

		end

	else

		LocalPlayer.Idled:Connect(function()

			if antiIdleEnabled then

				VirtualUser:CaptureController()
				VirtualUser:ClickButton2(Vector2.new())

			end

		end)

	end

end

--------------------------------------------------------
-- Button Connections
--------------------------------------------------------

autoPickupButton.MouseButton1Click:Connect(function()

	autoPickupEnabled = not autoPickupEnabled

	if autoPickupEnabled then

		autoPickupButton.Text = "Auto Pickup : ON"
		autoPickupButton.BackgroundColor3 = Color3.fromRGB(50,170,50)

		task.spawn(AutoPickup)

	else

		autoPickupButton.Text = "Auto Pickup : OFF"
		autoPickupButton.BackgroundColor3 = Color3.fromRGB(170,50,50)

	end

end)

antiIdleButton.MouseButton1Click:Connect(function()

	antiIdleEnabled = not antiIdleEnabled

	if antiIdleEnabled then

		EnableAntiIdle()

		antiIdleButton.Text = "Anti Idle : ON"
		antiIdleButton.BackgroundColor3 = Color3.fromRGB(50,170,50)

	else

		antiIdleButton.Text = "Anti Idle : OFF"
		antiIdleButton.BackgroundColor3 = Color3.fromRGB(170,50,50)

	end

end)
