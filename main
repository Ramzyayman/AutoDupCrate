local targetPosition = Vector3.new(3278.989, 502.870, 1158.379)

while true do
	task.wait(1)

	local found = false

	for _, prompt in ipairs(workspace:GetDescendants()) do
		if prompt:IsA("ProximityPrompt") 
		and prompt.ActionText == "Pickup" then

			local part = prompt.Parent

			if part:IsA("BasePart") then
				local distance = (part.Position - targetPosition).Magnitude

				if distance < 3 then
					print("Picking duplicated crate:", prompt:GetFullName())

					prompt:InputHoldBegin()
					task.wait(0.15)
					prompt:InputHoldEnd()

					found = true
					break
				end
			end
		end
	end

	if not found then
		print("Waiting for duplicated crate...")
	end
end
