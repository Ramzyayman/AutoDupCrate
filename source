local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local plot = workspace.Plots:WaitForChild(LocalPlayer.Name .. " Plot")
local duplicator = plot:WaitForChild("Machines"):WaitForChild("Duplicator")
local cratesFolder = duplicator:WaitForChild("CratesFolder")

local triggered = {}

local function triggerPrompt(prompt)
	if triggered[prompt] then
		return
	end

	triggered[prompt] = true

	prompt:InputHoldBegin()
	task.wait(0.15)
	prompt:InputHoldEnd()

	task.delay(1, function()
		triggered[prompt] = nil
	end)
end

while true do
	for _, crate in ipairs(cratesFolder:GetDescendants()) do
		if crate:IsA("ProximityPrompt") and crate.ActionText == "Pickup" then
			triggerPrompt(crate)
		end
	end

	task.wait(0.1)
end
